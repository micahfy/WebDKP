<?xml version="1.0" encoding="UTF-8"?>
<Ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/  ..\..\FrameXML\UI.xsd" xmlns="http://www.blizzard.com/wow/ui/">
  <!-- ================================================
       TEMPLATES 
       =================================================-->
  <!-- Define a template for a bid row entry -->
  <Frame name="ADKP_DKPBidLineTemplate" virtual="true" hidden="true">
    <Size>
      <AbsDimension x="350" y="20" />
    </Size>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentBackground">
          <Anchors>
            <Anchor point="TOPLEFT" />
            <Anchor point="BOTTOMRIGHT" />
          </Anchors>
          <Color r="1" g="1" b="1" a="1" />
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <FontString name="$parentName" inherits="ChatFontNormal" text="">
          <Anchors>
            <Anchor point="LEFT">
              <Offset>
                <AbsDimension x="2" y="0" />
              </Offset>
            </Anchor>
          </Anchors>
        </FontString>
        <FontString name="$parentBid" inherits="ChatFontNormal" text="">
          <Anchors>
            <Anchor point="LEFT">
              <Offset>
                <AbsDimension x="145" y="0" />
              </Offset>
            </Anchor>
          </Anchors>
        </FontString>
        <FontString name="$parentDKP" inherits="ChatFontNormal" text="">
          <Anchors>
            <Anchor point="LEFT">
              <Offset>
                <AbsDimension x="220" y="0" />
              </Offset>
            </Anchor>
          </Anchors>
        </FontString>
        <FontString name="$parentPost" inherits="ChatFontNormal" text="">
          <Anchors>
            <Anchor point="LEFT">
              <Offset>
                <AbsDimension x="290" y="0" />
              </Offset>
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>ADKP_PrepareFrame(self);
ADKP_LegacyCall(self, "OnLoad", function()

        ADKP_GetGlobal(this:GetName() .. "Background"):SetVertexColor(0, 0, 0, 0);
      
end);</OnLoad>
      <OnEnter>ADKP_LegacyCall(self, "OnEnter", function()

        ADKP_Bid_HandleMouseOver(self);
      
end, motion);</OnEnter>
      <OnLeave>ADKP_LegacyCall(self, "OnLeave", function()

        ADKP_Bid_HandleMouseLeave(self);
      
end, motion);</OnLeave>
      <OnMouseDown>ADKP_LegacyCall(self, "OnMouseDown", function()

        ADKP_Bid_SelectPlayerToggle();
      
end, button);</OnMouseDown>
    </Scripts>
  </Frame>
  <!-- ================================================
       MAIN FRAME
       =================================================-->
  <Frame name="ADKP_BidFrame" toplevel="true" parent="UIParent" movable="true" hidden="true">
    <!-- EVENT HANDLERS FOR THE MASTER FRAME -->
    <Scripts><OnLoad>ADKP_PrepareFrame(self);
ADKP_LegacyCall(self, "OnLoad", function()
ADKP_ApplyBackdrop(self, {bgFile = "Interface\\TutorialFrame\\TutorialFrameBackground", edgeFile = "Interface\\Tooltips\\UI-Tooltip-Border", tile = true, tileSize = 16, edgeSize = 16, insets = {left = 5, right = 5, top = 5, bottom = 5}});

end);</OnLoad>
      <OnShow>ADKP_LegacyCall(self, "OnShow", function()

        local mode = (WebDKP_Options and WebDKP_Options["AuctionMode"]) or "public";
        if ADKP_BidFrameAuctionPublic then ADKP_BidFrameAuctionPublic:SetChecked(mode ~= "anonymous") end
        if ADKP_BidFrameAuctionAnonymous then ADKP_BidFrameAuctionAnonymous:SetChecked(mode == "anonymous") end
        if ADKP_UpdateAuctionModeControls then ADKP_UpdateAuctionModeControls() end
        if ADKP_UpdateBidQueueWindow then ADKP_UpdateBidQueueWindow() end
        ADKP_Bid_UpdateTable();
      
end);</OnShow>
      <OnHide>ADKP_LegacyCall(self, "OnHide", function()

        if ADKP_BidQueueWindow then ADKP_BidQueueWindow:Hide() end
      
end);</OnHide>
      <OnMouseDown>ADKP_LegacyCall(self, "OnMouseDown", function()

        this:StartMoving();
        ADKP_GetGlobal("ADKP_BidFrameItem"):ClearFocus();
        ADKP_GetGlobal("ADKP_BidFrameTime"):ClearFocus();
      
end, button);</OnMouseDown>
      <OnMouseUp>ADKP_LegacyCall(self, "OnMouseUp", function()

        this:StopMovingOrSizing();
      
end, button);</OnMouseUp>
    </Scripts>
    <Size>
      <AbsDimension x="400" y="500" />
    </Size>
    <Anchors>
      <Anchor point="LEFT" />
    </Anchors>
    
    <!-- HEADER / ADDON TITLE-->
    <Layers>
      <Layer level="ARTWORK">
        <Texture name="$parentHeaderTexture" file="Interface\DialogFrame\UI-DialogBox-Header">
          <Size>
            <AbsDimension x="300" y="64" />
          </Size>
          <Anchors>
            <Anchor point="TOP">
              <Offset>
                <AbsDimension x="0" y="20" />
              </Offset>
            </Anchor>
          </Anchors>
        </Texture>
        <FontString name="$parentTitle" inherits="GameFontNormal" text="ADKP 竞拍系统">
          <Anchors>
            <Anchor point="TOP" relativeTo="$parentHeaderTexture">
              <Offset>
                <AbsDimension x="0" y="-14" />
              </Offset>
            </Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <!-- FRAMES (contains all gui elements -->
    <Frames>
      <!-- ITEM BEING BID ON -->
      <EditBox name="$parentItem" inherits="ADKPEditBoxTemplate">
        <Size>
          <AbsDimension x="130" y="32" />
        </Size>
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="90" y="-33" />
            </Offset>
          </Anchor>
        </Anchors>
        <Layers>
          <Layer level="ARTWORK">
            <FontString inherits="GameFontNormal" text="物品:">
              <Anchors>
                <Anchor point="TOPLEFT">
                  <Offset>
                    <AbsDimension x="-75" y="-8" />
                  </Offset>
                </Anchor>
              </Anchors>
            </FontString>
          </Layer>
        </Layers>
        <Scripts>
          <OnLoad>ADKP_PrepareFrame(self);
ADKP_LegacyCall(self, "OnLoad", function()

            ADKP_GetGlobal(this:GetParent():GetName().."Item"):SetAutoFocus( false );
            this:SetBackdropColor(0, 0, 0, 0.6);
            this:SetBackdropBorderColor(0.5, 0.5, 0.5, 1);
          
end);</OnLoad>
          <OnEscapePressed>ADKP_LegacyCall(self, "OnEscapePressed", function()

            ADKP_GetGlobal(this:GetParent():GetName().."Item"):ClearFocus();
          
end);</OnEscapePressed>
          <OnEnterPressed>ADKP_LegacyCall(self, "OnEnterPressed", function()

            ADKP_GetGlobal(this:GetParent():GetName().."Item"):ClearFocus();
          
end);</OnEnterPressed>
        </Scripts>
      </EditBox>
      <!-- 拍卖模式切换（公开/匿名） -->
      <CheckButton name="ADKP_BidFrameAuctionPublic" inherits="ADKP_ForeverUICheckButtonTemplate">
        <Size>
          <AbsDimension x="20" y="20" />
        </Size>
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="230" y="-33" />
            </Offset>
          </Anchor>
        </Anchors>
        <Layers>
          <Layer level="ARTWORK">
            <FontString inherits="GameFontNormalSmall" text="公开">
