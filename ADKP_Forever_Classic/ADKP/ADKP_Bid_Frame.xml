          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="295" y="-33" />
            </Offset>
          </Anchor>
        </Anchors>
        <Layers>
          <Layer level="ARTWORK">
            <FontString inherits="GameFontNormalSmall" text="匿名">
              <Anchors>
                <Anchor point="LEFT">
