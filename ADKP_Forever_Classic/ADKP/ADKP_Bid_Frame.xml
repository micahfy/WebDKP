                    <AbsDimension x="25" y="0" />
                  </Offset>
                </Anchor>
              </Anchors>
            </FontString>
          </Layer>
        </Layers>
        <Scripts><OnLoad>ADKP_PrepareFrame(self);</OnLoad>
          <OnClick>ADKP_LegacyCall(self, "OnClick", function()

            ADKP_SelectAuctionMode("anonymous");
          
end, button, down);</OnClick>
        </Scripts>
      </CheckButton>
      <!-- BID TIME LIMIT -->
