      <!-- START / STOP BIDDING BUTTON-->
      <Button name="$parentBidButton" inherits="ADKP_ForeverOptionsButtonTemplate" text="开始竞拍!">
        <Anchors>
          <Anchor point="TOP" relativePoint="TOP">
