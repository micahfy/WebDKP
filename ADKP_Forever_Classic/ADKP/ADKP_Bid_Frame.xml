      </Button>
      <!-- Countdown trigger -->
      <Button name="$parentManualCountdownButton" inherits="ADKP_ForeverOptionsButtonTemplate" text="倒计时">
        <Anchors>
          <Anchor point="LEFT" relativeTo="$parentBidButton" relativePoint="RIGHT">
            <Offset>
              <AbsDimension x="8" y="0" />
            </Offset>
          </Anchor>
        </Anchors>
        <Size>
          <AbsDimension x="95" y="25" />
        </Size>
        <Scripts><OnLoad>ADKP_PrepareFrame(self);</OnLoad>
          <OnClick>ADKP_LegacyCall(self, "OnClick", function()

            ADKP_ManualCountdown_Toggle();
          
end, button, down);</OnClick>
        </Scripts>
      </Button>
      <Button name="$parentAnnounceHighButton" inherits="ADKP_ForeverOptionsButtonTemplate" text="通报最高分">
        <Anchors>
          <Anchor point="LEFT" relativeTo="$parentManualCountdownButton" relativePoint="RIGHT">
            <Offset>
              <AbsDimension x="8" y="0" />
