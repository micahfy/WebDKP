        </Size>
        <Scripts><OnLoad>ADKP_PrepareFrame(self);</OnLoad>
          <OnClick>ADKP_LegacyCall(self, "OnClick", function()

            ADKP_Bid_AnnounceSelected();
          
end, button, down);</OnClick>
          <OnEnter>ADKP_LegacyCall(self, "OnEnter", function()

            GameTooltip:SetOwner(this, "ANCHOR_RIGHT");
            GameTooltip:SetText("向团队通报当前选择的分数（匿名拍卖）", 1, 1, 1);
            GameTooltip:Show();
          
end, motion);</OnEnter>
          <OnLeave>ADKP_LegacyCall(self, "OnLeave", function()

            GameTooltip:Hide();
          
end, motion);</OnLeave>
        </Scripts>
      </Button>
      <!-- DKP TABLE COLUMN NAMES -->
      <Button name="$parentName" inherits="ADKP_LogTabTemplate">
        <Anchors>
          <Anchor point="TOPLEFT">
            <Offset>
              <AbsDimension x="16" y="-160" />
