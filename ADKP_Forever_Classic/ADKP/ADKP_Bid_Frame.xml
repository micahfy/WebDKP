                  <Offset>
                    <AbsDimension x="8" y="0" />
                  </Offset>
                </Anchor>
              </Anchors>
            </FontString>
          </Layer>
          <Layer level="ARTWORK">
            <FontString name="$parentListTitle" inherits="GameFontNormal" text="需求竞拍列表:">
              <Anchors>
                <Anchor point="TOPLEFT">
                  <Offset>
                    <AbsDimension x="0" y="20" />
                  </Offset>
                </Anchor>
              </Anchors>
